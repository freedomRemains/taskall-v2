{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/taskall-v2/taskall-v2.log",
            "log_group_name": "/taskall-v2/application",
            "log_stream_name": "{instance_id}/app"
          },
          {
            "file_path": "/var/log/taskall-v2/release.log",
            "log_group_name": "/taskall-v2/application",
            "log_stream_name": "{instance_id}/release"
          },
          {
            "file_path": "/var/log/taskall-v2/backup.log",
            "log_group_name": "/taskall-v2/application",
            "log_stream_name": "{instance_id}/backup"
          }
        ]
      }
    }
  }
}
