[Unit]
Description=taskall-v2 Spring Boot application
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/taskall-v2/config.env
EnvironmentFile=/etc/taskall-v2/secrets.env
WorkingDirectory=/opt/taskall-v2
# メール接続情報(SSM Parameter Store由来)を毎回の起動直前に取得し、secrets.envへ書き出す。
# 取得に失敗した場合(SSMパラメータ未設定等)はExecStartPreが非0終了し、アプリ自体も起動しない。
ExecStartPre=/opt/taskall-v2/bin/render-secrets-env.sh
ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar ${APP_JAR} --server.port=${APP_PORT}
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/taskall-v2/taskall-v2.log
StandardError=append:/var/log/taskall-v2/taskall-v2.log

[Install]
WantedBy=multi-user.target
